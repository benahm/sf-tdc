{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/TdcInitResult",
  "definitions": {
    "TdcInitResult": {
      "type": "object",
      "properties": {
        "configFile": {
          "type": "string"
        },
        "config": {
          "$ref": "#/definitions/TdcConfig"
        }
      },
      "required": [
        "configFile",
        "config"
      ],
      "additionalProperties": false
    },
    "TdcConfig": {
      "type": "object",
      "properties": {
        "sourceDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Folders to scan, relative to the project root. Defaults to the packageDirectories of sfdx-project.json."
        },
        "ruleSelectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rule selectors of code-analyzer: engines, tags, severities or `engine:rule`, combined with a colon."
        },
        "severityCosts": {
          "type": "object",
          "properties": {
            "Critical": {
              "type": "number"
            },
            "High": {
              "type": "number"
            },
            "Moderate": {
              "type": "number"
            },
            "Low": {
              "type": "number"
            },
            "Info": {
              "type": "number"
            }
          },
          "required": [
            "Critical",
            "High",
            "Moderate",
            "Low",
            "Info"
          ],
          "additionalProperties": false,
          "description": "Cost of a finding, in TDC, by severity of its rule. A rule of `rules` can have its own cost."
        },
        "dailyRate": {
          "type": "number",
          "description": "Cost of a day of work, to price the debt."
        },
        "currency": {
          "type": "string"
        },
        "hoursPerDay": {
          "type": "number"
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RuleSetting"
          }
        },
        "goal": {
          "$ref": "#/definitions/Goal"
        },
        "game": {
          "type": "object",
          "properties": {
            "leaderboard": {
              "type": "string",
              "enum": [
                "named",
                "team"
              ],
              "description": "\"named\" ranks each author in the dashboard; \"team\" sums them into one, and leaves names out of the report."
            },
            "rewardDeletedFiles": {
              "type": "boolean",
              "description": "Whether the dashboard awards coins for debt removed with deleted files. Defaults to false."
            }
          },
          "required": [
            "leaderboard"
          ],
          "additionalProperties": false
        },
        "verifier": {
          "type": "object",
          "properties": {
            "runs": {
              "type": "number",
              "description": "Times a prompt is asked: every answer must agree."
            }
          },
          "required": [
            "runs"
          ],
          "additionalProperties": false,
          "description": "Settings for prompt verifiers of declared debt."
        }
      },
      "required": [
        "ruleSelectors",
        "severityCosts",
        "dailyRate",
        "currency",
        "hoursPerDay",
        "rules",
        "game"
      ],
      "additionalProperties": false
    },
    "RuleSetting": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cost": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "Goal": {
      "type": "object",
      "properties": {
        "debt": {
          "type": "number",
          "description": "Debt to reach, in TDC."
        },
        "date": {
          "type": "string",
          "description": "Deadline, as YYYY-MM-DD."
        }
      },
      "required": [
        "debt",
        "date"
      ],
      "additionalProperties": false
    }
  }
}